#!/usr/bin/env bash
# bin/pet-talk-server — launcher for the pet-talk duplex server, meant to be
# run either by hand or as the ProgramArguments[0] of a launchd user agent
# (see launchd/com.unfoundbox.pet-talk-server.plist.template, installed via
# `make install-agent` / bin/agent-ctl.sh).
#
# launchd hands a job a minimal PATH, so every binary here is resolved
# explicitly (same reasoning as motionvector/inference-fleet/bin/serve).
#
# What it does:
#   1. cd to the repo root (computed from this script's own real path, so it
#      works from a symlink, a launchd invocation, or a checkout at any path).
#   2. Resolve the Python interpreter: $PET_TALK_PYTHON, else
#      ~/miniconda3/envs/local-ml-py311/bin/python.
#   3. If `doppler` is on PATH, run under
#      `doppler run --project unfoundbox --config dev_personal --`; otherwise
#      run directly (so `--dry-run` and CI hosts without Doppler still work).
#   4. Bind $PET_TALK_SERVER_HOST:$PET_TALK_SERVER_PORT (default
#      127.0.0.1:8089).
#   5. Rotate and then log to
#      "$HOME/Library/Application Support/pet-talk/server.log".
#
# --dry-run prints every resolved value and the exact command that would run,
# execs nothing, touches no log file, starts no server.
set -u

usage() {
  cat <<'EOF'
Usage: bin/pet-talk-server [--dry-run] [--help]

Env overrides:
  PET_TALK_PYTHON            interpreter to run uvicorn with
                              (default: ~/miniconda3/envs/local-ml-py311/bin/python)
  PET_TALK_SERVER_HOST       bind host (default: 127.0.0.1)
  PET_TALK_SERVER_PORT       bind port (default: 8089)
  PET_TALK_LOG_MAX_BYTES     rotate server.log once it exceeds this many
                              bytes (default: 10485760, i.e. 10MB); keeps
                              exactly one prior copy at server.log.1
  PET_TALK_NO_DOPPLER=1      skip `doppler run` even if doppler is on PATH
EOF
}

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "pet-talk-server: unknown argument: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

# 1. Repo root: resolve this script's own real path (following symlinks),
# then go up one directory from bin/.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
if command -v realpath >/dev/null 2>&1; then
  SCRIPT_PATH="$(realpath "$SCRIPT_PATH")"
fi
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# 2. Interpreter.
PYTHON="${PET_TALK_PYTHON:-$HOME/miniconda3/envs/local-ml-py311/bin/python}"

# 3. Doppler, only if present and not explicitly skipped.
DOPPLER_BIN=""
if [[ "${PET_TALK_NO_DOPPLER:-0}" != "1" ]]; then
  for c in "$HOME/.local/bin/doppler" /opt/homebrew/bin/doppler /usr/local/bin/doppler; do
    if [[ -x "$c" ]]; then DOPPLER_BIN="$c"; break; fi
  done
  if [[ -z "$DOPPLER_BIN" ]] && command -v doppler >/dev/null 2>&1; then
    DOPPLER_BIN="$(command -v doppler)"
  fi
fi

# 4. Bind address.
HOST="${PET_TALK_SERVER_HOST:-127.0.0.1}"
PORT="${PET_TALK_SERVER_PORT:-8089}"

# 5. Log path + rotation.
LOG_DIR="$HOME/Library/Application Support/pet-talk"
LOG_FILE="$LOG_DIR/server.log"
MAX_LOG_BYTES="${PET_TALK_LOG_MAX_BYTES:-10485760}"

rotate_log() {
  [[ -f "$LOG_FILE" ]] || return 0
  local size
  size=$(stat -f%z "$LOG_FILE" 2>/dev/null || stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
  if [[ "$size" =~ ^[0-9]+$ ]] && (( size > MAX_LOG_BYTES )); then
    mv -f "$LOG_FILE" "$LOG_FILE.1"
  fi
}

CMD=()
if [[ -n "$DOPPLER_BIN" ]]; then
  CMD+=("$DOPPLER_BIN" run --project unfoundbox --config dev_personal --)
fi
CMD+=("$PYTHON" -m uvicorn server.app:app --host "$HOST" --port "$PORT")

if [[ "$DRY_RUN" == "1" ]]; then
  echo "pet-talk-server --dry-run"
  echo "  repo root:   $REPO_ROOT"
  echo "  interpreter: $PYTHON"
  echo "  doppler:     ${DOPPLER_BIN:-<none found — running without doppler run>}"
  echo "  bind:        $HOST:$PORT"
  echo "  log file:    $LOG_FILE  (rotates at ${MAX_LOG_BYTES} bytes, keeps 1 prior copy)"
  echo "  would cd:    $REPO_ROOT"
  echo "  would exec:  ${CMD[*]}"
  exit 0
fi

if [[ ! -x "$PYTHON" ]]; then
  echo "pet-talk-server: FAIL — interpreter not found or not executable: $PYTHON" >&2
  exit 1
fi

cd "$REPO_ROOT" || { echo "pet-talk-server: FAIL — cannot cd to repo root: $REPO_ROOT" >&2; exit 1; }

mkdir -p "$LOG_DIR"
rotate_log

# Everything from here on is appended to the log (rotation already happened
# above, so this open always starts at-or-under the size budget).
exec >>"$LOG_FILE" 2>&1
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') pet-talk-server starting: repo=$REPO_ROOT python=$PYTHON doppler=${DOPPLER_BIN:-none} bind=$HOST:$PORT"

exec "${CMD[@]}"
