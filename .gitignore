# pet-talk gitignore — binaries and runtime exhaust stay out; code stays in.
# audio evidence (reproducible via bake scripts)
*.wav
*.mp3
*.ogg
*.aiff

# telemetry + runtime
server/turns.jsonl
*.jsonl

# builds + deps
web/dist/
web/node_modules/
node_modules/
dist/
__pycache__/
*.pyc
.venv/
venv/

# built binaries — never committed; build on ssh air (fan rule), see Makefile
bin/*
!bin/.gitkeep

# QA scratch (receipts, fixtures written by tests) — never committed
.qa-scratch/

# OS + editor
.DS_Store
*.swp
.env

# agent worktrees
.claude/worktrees/
